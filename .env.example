# Copy to .env and adjust. .env itself is git-ignored and must stay that way.

POSTGRES_USER=landmoney
POSTGRES_PASSWORD=landmoney_local_only
POSTGRES_DB=landmoney

# 5433, not the default 5432, so this stack can run alongside another local
# Postgres without a port clash.
POSTGRES_PORT=5433

# 127.0.0.1 rather than "localhost": on Windows the name resolves to ::1
# first, the port is published on IPv4 only, and Docker Desktop swallows the
# attempt instead of refusing it -- so the client hangs instead of failing.
# Lesson paid for once already; not paying for it twice.
POSTGRES_HOST=127.0.0.1
