<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      <clear /> drops every source inherited from the machine-level and
      user-level NuGet.config. Without it this project picks up whatever feeds
      happen to be registered on the developer's box.

      That is not hypothetical: the machine this was written on had a Telerik
      feed registered globally, left behind by a Progress install. It requires
      credentials, answers 404 to every package lookup, and aborts the whole
      restore, even though the packages being asked for live on nuget.org.
      CI would never have had that feed, so the machine and CI would have been
      resolving packages differently. Restore is part of the build, and a build
      that depends on machine state is not reproducible.
    -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
