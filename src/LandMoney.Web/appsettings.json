{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // The Python categorizer -- #39. Not a secret, so it lives in the committed
  // file rather than in user-secrets or a Container Apps secret: it names a
  // service, it carries no credential, and the three roads configuration takes
  // to this application (CLAUDE.md, "Configuration reaches the deployed app by
  // three roads") are about the connection string.
  //
  // localhost:8000 is the default because that is where docker-compose publishes
  // the categorizer, so `dotnet run` on this machine works with nothing set. The
  // app *container* overrides it with Categorizer__BaseUrl=http://categorizer:8000,
  // because inside the compose network localhost is the app's own container.
  // #52. Present and empty, which is a configured state meaning "no identity
  // provider", not an oversight. AuthenticationSetup reads exactly these two: with
  // both blank it signs every request in as the local developer in Development,
  // and refuses every request anywhere else. Filling them in here would put a
  // provider into the image and into the local loop at once.
  //
  // Authority and ClientId are not secrets -- they name a registration, the way
  // the three OIDC ids for GitHub Actions are repository variables rather than
  // repository secrets (#38). ClientSecret is one, and it is deliberately absent
  // from this file: deployed it is a Container Apps secret, and step 15 of
  // docs/deploy-azure.md is how it gets there.
  "Authentication": {
    "Oidc": {
      "Authority": "",
      "ClientId": ""
    }
  },

  "Categorizer": {
    "BaseUrl": "http://localhost:8000",
    "TimeoutSeconds": 2
  }
}
