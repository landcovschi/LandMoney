# Copy to .env and adjust. .env itself is git-ignored and must stay that way.

POSTGRES_USER=landmoney
POSTGRES_PASSWORD=landmoney_local_only
POSTGRES_DB=landmoney

# 5433, not the default 5432, so this stack can run alongside another local
# Postgres without a port clash.
POSTGRES_PORT=5433

# 127.0.0.1 rather than "localhost": on Windows the name resolves to ::1
# first, the port is published on IPv4 only, and Docker Desktop swallows the
# attempt instead of refusing it -- so the client hangs instead of failing.
# Lesson paid for once already; not paying for it twice.
POSTGRES_HOST=127.0.0.1

# --- the categorizer -- #59 ---------------------------------------------------

# `rules` (the default, free) or `model` (an Anthropic call per saved
# transaction). Anything else stops the container on purpose: a typo that fell
# back to the rules would serve the baseline while the deployment believed a model
# was running, and the number recorded for it would be the old one.
CATEGORIZER_PREDICTOR=rules

# **Never commit a value for this.** `.env` is git-ignored and stays that way;
# nothing in this repository reads it out or prints it, and it must not appear in
# an example command. Leave it blank here -- the key belongs only in `.env`.
#
# Only the `model` predictor above reads it. With it wrong or absent, the call
# fails, the failure is logged, and the transaction is saved with no category:
# #39's fallback, unchanged by there being a model behind the port.
ANTHROPIC_API_KEY=

# Optional, and all three have defaults in anthropic_predictor.py. Here so that
# #60 can move them without editing code.
# CATEGORIZER_MODEL=claude-opus-5
# CATEGORIZER_EFFORT=low
# CATEGORIZER_TIMEOUT_SECONDS=6

# What a call costs, in USD per million tokens -- #64. **Deliberately not
# defaulted in code**: a price moves without this repository noticing, and a
# stale figure in a log is worse than an absent one because it is believed. With
# these unset the per-call line still reports the tokens, which are the fact;
# the money is the multiplication. Both or neither -- half of it is an error
# line, because silence there looks exactly like never having tried.
#
# The published rate for claude-opus-5 on 2026-08-29, which is what to copy in
# after checking it is still the rate:
# CATEGORIZER_PRICE_INPUT_PER_MTOK=5.00
# CATEGORIZER_PRICE_OUTPUT_PER_MTOK=25.00
