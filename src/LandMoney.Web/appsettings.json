{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // #52. Present and empty, which is a configured state and not an oversight.
  // AuthenticationSetup reads this key to decide who may create an account: with
  // it blank, registration on a developer machine asks for no code, and anywhere
  // else it refuses every new account. Filling it in here would put one shared
  // secret into the image and into every checkout at once.
  //
  // Deployed it is a Container Apps secret, referenced rather than pasted, the way
  // the connection string is (#36). Step 15 of docs/deploy-azure.md has the
  // commands.
  //
  // There is nothing else here to configure. Accounts live in this application's
  // own database -- there is no identity provider, no client id and no redirect
  // URI to keep in step with anything.
  "Authentication": {
    "InviteCode": ""
  },

  // The Python categorizer -- #39. Not a secret, so it lives in the committed
  // file rather than in user-secrets or a Container Apps secret: it names a
  // service, it carries no credential, and the three roads configuration takes
  // to this application (CLAUDE.md, "Configuration reaches the deployed app by
  // three roads") are about the connection string.
  //
  // localhost:8000 is the default because that is where docker-compose publishes
  // the categorizer, so `dotnet run` on this machine works with nothing set. The
  // app *container* overrides it with Categorizer__BaseUrl=http://categorizer:8000,
  // because inside the compose network localhost is the app's own container.
  "Categorizer": {
    "BaseUrl": "http://localhost:8000",
    "TimeoutSeconds": 2
  }
}
